{
  "name": "@tietoware/forms",
  "version": "1.0.0",
  "description": "Schema-driven Qwik City forms for TietoWare App",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TietoWare/tietoware-forms.git"
  },
  "homepage": "https://github.com/TietoWare/tietoware-forms#readme",
  "bugs": {
    "url": "https://github.com/TietoWare/tietoware-forms/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./generate": {
      "types": "./dist/generate.d.ts",
      "import": "./dist/generate.js"
    }
  },
  "bin": {
    "tietoware-forms": "./dist/cli.js"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate": "node dist/cli.js generate",
    "pack:check": "node scripts/verify-package.mjs"
  },
  "peerDependencies": {
    "@builder.io/qwik": ">=1.8 <3",
    "@builder.io/qwik-city": ">=1.8 <3"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.16.0",
    "@builder.io/qwik-city": "^1.16.0",
    "@testing-library/dom": "^10.4.0",
    "@types/node": "^22.15.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
